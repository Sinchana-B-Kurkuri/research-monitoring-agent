# Environment configuration
# Copy this file to .env and fill in values.
# NEVER commit .env — it is gitignored.

# Application
LOG_LEVEL=INFO

# Seed interest text for relevance ranking (override in .env to customise)
# SEED_INTEREST=

# Phase 2: arXiv corpus configuration
# CORPUS_START_DATE=2020-01-01
# CORPUS_END_DATE=2024-12-31
# CORPUS_CATEGORIES=cs.CL,cs.LG,cs.AI

# Reference sample
# REFERENCE_SAMPLE_SIZE=5000
# REFERENCE_SAMPLE_SEED=42

# Embedding model
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Phase 3: PostgreSQL Database
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/research_monitor

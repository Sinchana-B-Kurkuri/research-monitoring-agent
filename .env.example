# Environment configuration
# Copy this file to .env and fill in values.
# NEVER commit .env — it is gitignored.

# Application
LOG_LEVEL=INFO

# Seed interest text for relevance ranking (override in .env to customise)
# SEED_INTEREST=

# Phase 2: arXiv corpus configuration
# CORPUS_START_DATE=2020-01-01
# CORPUS_END_DATE=2024-12-31
# CORPUS_CATEGORIES=cs.CL,cs.LG,cs.AI

# Reference sample
# REFERENCE_SAMPLE_SIZE=5000
# REFERENCE_SAMPLE_SEED=42

# Embedding model
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Phase 3: PostgreSQL Database
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/research_monitor

# Phase 4: Threshold Calibration and Evaluation
# PROVISIONAL_P_HIGH=98.0
# PROVISIONAL_P_LOW=90.0
# CALIBRATED_P_HIGH=
# CALIBRATED_P_LOW=
# EVALUATION_SAMPLE_SIZE=500
# EVALUATION_DEV_RATIO=0.70
# EVALUATION_SEED=42
# TEST_ACCESS_LOG_PATH=experiments/results/test_access.log

# Phase 7: Gated LLM Summarization
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# LLM_TEMPERATURE=0.0
# SUMMARY_PROMPT_VERSION=v1.0

# Phase 8: Live arXiv Monitoring
# LIVE_MAX_RESULTS=50
# LIVE_DAYS=0
# LIVE_SLEEP_SECONDS=3.0

# Phase 9: Production Deployment & Daily Scheduling
# PORT=8000
# HOST=0.0.0.0
# Hosted PostgreSQL with pgvector (e.g. Neon, Supabase, AWS RDS, GCP Cloud SQL)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require
# DAILY_INGESTION_MAX_PAPERS=50
# REVIEW_QUEUE_MAX_TASKS=15
# DIGEST_MAX_ITEMS=20
